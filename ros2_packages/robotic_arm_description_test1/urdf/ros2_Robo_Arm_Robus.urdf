<?xml version="1.0" encoding="utf-8"?>
<robot name="robotic_arm_5dof">

  <!-- ========================================== -->
  <!-- MATERIALS & COLOR PALETTE                  -->
  <!-- ========================================== -->
  <material name="red_plastic">
    <color rgba="0.85 0.12 0.08 1.0"/>
  </material>
  <material name="dark_red_base">
    <color rgba="0.70 0.08 0.05 1.0"/>
  </material>
  <material name="white_plastic">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="servo_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="stripes_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>
  <material name="metallic_screw">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <!-- ========================================== -->
  <!-- 1. BASE ASSEMBLY                           -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.055"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.058" length="0.006"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.058" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0275" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000438" ixy="0" ixz="0" iyy="0.000438" iyz="0" izz="0.000625"/>
    </inertial>
  </link>

  <!-- Giunto 1: Rotazione Base -->
  <joint name="joint_1_base_rotation" type="revolute">
    <parent link="base_link"/>
    <child link="rotating_base"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="rotating_base">
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.005"/>
      </geometry>
      <material name="dark_red_base"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.04"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- 2. SPALLA                                  -->
  <!-- ========================================== -->
  <joint name="joint_2_shoulder" type="revolute">
    <parent link="rotating_base"/>
    <child link="shoulder_link"/>
    <origin xyz="0.01 0 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0.15 0"/>
      <geometry>
        <box size="0.025 0.042 0.12"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.038"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.026"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.105" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.042 0.03"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.033 0.043 0.008"/>
      </geometry>
      <material name="stripes_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.116" rpy="0 0 0"/>
      <geometry>
        <box size="0.033 0.043 0.004"/>
      </geometry>
      <material name="stripes_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.045 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.22"/>
      <inertia ixx="0.00028" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- 3. AVAMBRACCIO BIANCO                      -->
  <!-- ========================================== -->
  <joint name="joint_3_forearm" type="revolute">
    <parent link="shoulder_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="3.1415" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.042 0.09"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.036"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>
    <visual>
      <origin xyz="-0.015 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.04"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.044 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00011" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- 4. POLSO ARROTONDATO                       -->
  <!-- ========================================== -->
  <joint name="joint_4_wrist" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="wrist_link">
    <!-- Base rettangolare inferiore -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.038 0.03"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>
    
    <!-- Testa arrotondata / cupola del perno -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.026"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>

    <!-- Servomotore MG90S polso -->
    <visual>
      <origin xyz="0 0.004 0.022" rpy="0 0 0"/>
      <geometry>
        <box size="0.023 0.012 0.023"/>
      </geometry>
      <material name="servo_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.044"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.022" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000014" ixy="0" ixz="0" iyy="0.000012" iyz="0" izz="0.000006"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- 5. MANO / PINZA RUOTATA DI 90°             -->
  <!-- ========================================== -->
  <joint name="joint_5_hand" type="revolute">
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <origin xyz="-0.015 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="hand_link">
    <!-- Staffa laterale di accoppiamento al perno -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.005"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>

    <!-- Braccio verticale di supporto pinza -->
    <visual>
      <origin xyz="0.008 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.008 0.05"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>

    <!-- Piastra supporto servomotore pinza (ruotata di 90°) -->
    <visual>
      <origin xyz="0.008 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.042 0.028 0.008"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>

    <!-- Micro Servo pinza orientato -->
    <visual>
      <origin xyz="0.008 0 0.04" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.023 0.012 0.023"/>
      </geometry>
      <material name="servo_black"/>
    </visual>

    <!-- Leveraggi bianchi (apertura lungo asse X) -->
    <visual>
      <origin xyz="0.018 0 0.065" rpy="0.1 0 0"/>
      <geometry>
        <box size="0.008 0.004 0.045"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>
    <visual>
      <origin xyz="-0.002 0 0.065" rpy="-0.1 0 0"/>
      <geometry>
        <box size="0.008 0.004 0.045"/>
      </geometry>
      <material name="white_plastic"/>
    </visual>

    <!-- Chela 1 Rossa (ruotata di 90°) -->
    <visual>
      <origin xyz="0.022 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.065"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>

    <!-- Chela 2 Rossa (ruotata di 90°) -->
    <visual>
      <origin xyz="-0.006 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.008 0.065"/>
      </geometry>
      <material name="red_plastic"/>
    </visual>

    <!-- Gommini antiscivolo interni -->
    <visual>
      <origin xyz="0.012 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.006 0.025"/>
      </geometry>
      <material name="servo_black"/>
    </visual>
    <visual>
      <origin xyz="0.004 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.006 0.025"/>
      </geometry>
      <material name="servo_black"/>
    </visual>

    <!-- Viti e perni metallici -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.002" length="0.02"/>
      </geometry>
      <material name="metallic_screw"/>
    </visual>
    <visual>
      <origin xyz="0.022 0 0.075" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0018" length="0.02"/>
      </geometry>
      <material name="metallic_screw"/>
    </visual>
    <visual>
      <origin xyz="-0.006 0 0.075" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0018" length="0.02"/>
      </geometry>
      <material name="metallic_screw"/>
    </visual>

    <!-- Collisione centrata sulla nuova sagoma ruotata -->
    <collision>
      <origin xyz="0.008 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.035 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.008 0 0.06" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- 6. TOOL CENTER POINT (TCP / PUNTA PINZA)   -->
  <!-- ========================================== -->
  <link name="tool0"/>

  <joint name="joint_tool0" type="fixed">
    <parent link="hand_link"/>
    <child link="tool0"/>
    <!-- Offset reale dal perno alla punta delle chele -->
    <origin xyz="0.008 0 0.11" rpy="0 0 0"/>
  </joint>

</robot>